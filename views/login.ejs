<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="/style.css">
</head>

<body class="container" style="margin-top: 50px;">
    <h1>Login</h1>
    <form action="/login" method="post">
        <label for="username">Username:</label>
        <input type="text" id="username" name="username" class="input-box rounded" required>
        <br>

        <label for="password">Password:</label>
        <input type="password" id="password" name="password" class="input-box rounded" required>
        <br>

        <button type="submit" class="btn-primary btn-sm">Login</button>
    </form>

    <br/>

    <p>Don't have an account? <a href="/register" class="btnprimary">Register here</a>.</p>
</body>
</html>